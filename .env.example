# Realtime Database path that holds sensor readings (matches the device's
# HISTORY_PATH). Each child value is expected to look like:
#   { ch2o_ppm: <float>, level: <string>, wifi: <string>,
#     uptime_ms: <int>, timestamp_unix_s: <int> }
VITE_FIREBASE_READINGS_PATH=devices/device01/history
